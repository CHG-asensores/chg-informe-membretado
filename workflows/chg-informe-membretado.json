      ]
    },
    "Renderizar HTML Membretado":    { "main": [[{ "node": "Generar PDF con Gotenberg",       "type": "main", "index": 0 }]] },
    "Generar PDF con Gotenberg":     { "main": [[{ "node": "Subir PDF Membretado a Drive",    "type": "main", "index": 0 }]] },
    "Preparar Datos de Error":       { "main": [[{ "node": "Mover PDF a Carpeta Errores Drive", "type": "main", "index": 0 }]] }
  },
